# Variables de entorno para el stack de Asalith.
# En Portainer: copiar este contenido en "Environment variables" del stack
# (o subirlo como fichero stack.env). En local: guardarlo como .env.
# Los valores con contraseña son OBLIGATORIOS y no tienen valor por defecto.

# --- Obligatorias ---
EULA=TRUE
SERVICE_PASSWORD_RCON=cambiame
CFG_MYSQL_ROOT_PASSWORD=cambiame
CFG_MYSQL_USER=asalith
CFG_MYSQL_PASSWORD=cambiame
CFG_MYSQL_DATABASE=asalith

# --- Acceso (no premium + lista blanca) ---
# Nombres separados por comas. Con ONLINE_MODE=false los nombres no se
# verifican contra Mojang: la lista blanca es un filtro, no autenticación.
MINECRAFT_WHITELIST=
MINECRAFT_OPS=
# MINECRAFT_ONLINE_MODE=false
# MINECRAFT_ENFORCE_WHITELIST=true

# --- Opcionales (se muestran los valores por defecto) ---
# HOST_PORT=25565
# RAM_ASALITH=6G
# USE_AIKAR_FLAGS=true
# MINECRAFT_VERSION=1.20.1
# FORGE_VERSION=47.4.22
# PACKWIZ_URL=https://perlanddev.github.io/asalith-modpack/pack.toml
# MINECRAFT_SERVER_NAME=Asalith
# MINECRAFT_MOTD=Asalith
# MINECRAFT_DIFFICULTY=normal
# MINECRAFT_MAX_PLAYERS=100
# MINECRAFT_VIEW_DISTANCE=10
# MINECRAFT_PLAYER_IDLE_TIMEOUT=0
# MINECRAFT_ENABLE_AUTOPAUSE=false
# RESOURCEPACK_URL=
